<UXML xmlns="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Template name="buttom_bar" src="project://database/Assets/Assets/ui_elements/buttom_bar.uxml?fileID=9197481963319205126&amp;guid=98b4b6ee9081ff24da748cb9fbfe184d&amp;type=3#buttom_bar" />
    <Style src="project://database/Assets/style.uss?fileID=7433441132597879392&amp;guid=a6367d7c553692241b35c93b11b1b048&amp;type=3#style" />
    <VisualElement name="top_bar" template="top_bar" style="margin-bottom: 1%;">
        <VisualElement name="top_background" style="flex-grow: 1; height: 300px; background-color: rgb(33, 26, 82); max-height: 300px; flex-direction: column-reverse; padding-bottom: 0; margin-top: 0; flex-shrink: 1; align-items: stretch; justify-content: space-between; align-self: stretch;">
            <VisualElement style="flex-grow: 1; height: 85px; flex-direction: row; flex-wrap: nowrap;">
                <VisualElement name="VisualElement" data-source="project://database/Assets/Assets/SCObjects/LastScene.asset?fileID=11400000&amp;guid=b6dbf3a37e83c204a833de39627a0ea9&amp;type=2#LastScene" class="CButton" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; flex-shrink: 1; margin-right: 0; padding-top: 0; margin-bottom: 0; margin-left: 0; height: 183px; -unity-slice-left: 0; -unity-slice-top: 0; -unity-slice-right: 0; -unity-slice-bottom: 0; background-repeat: no-repeat no-repeat; background-position-x: left -10px; background-position-y: center 0; flex-wrap: nowrap; margin-top: 0; rotate: 180deg; padding-right: 0; padding-bottom: 0; padding-left: 0; left: -323px;" />
                <Label text="Uddannelses Forløb" enable-rich-text="false" class="Label barlow" style="font-size: 63px; margin-right: 63px; -unity-text-align: middle-right; white-space: pre-wrap; width: 625px; height: 200px; padding-bottom: 18px; -unity-font-style: bold;" />
            </VisualElement>
            <VisualElement style="flex-grow: 1;" />
        </VisualElement>
    </VisualElement>
    <VisualElement name="VisualElement" style="flex-grow: 1; margin-bottom: 315px;">
        <ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden">
            <VisualElement class="ui_element_background" style="flex-grow: 1; flex-direction: row; width: 95%; align-self: center; height: auto; margin-top: 15px; margin-bottom: 15px;">
                <VisualElement enabled="false" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; width: 300px; height: 200px; align-self: stretch; margin-top: 10px; margin-bottom: 0; padding-top: 0; border-top-width: 0; border-bottom-width: 0; top: 19px; left: auto; align-items: stretch; justify-content: space-between;" />
                <Foldout text="App for new medialogy students at AAU" value="false" enabled="true" name="Foldout" style="-unity-text-align: middle-center; width: 100%; height: auto; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=13ff8cb063d69b84bba985c7c7ef9c52&amp;type=3#Barlow-Regular&quot;); min-height: auto; max-height: none; align-items: stretch; justify-content: space-evenly; align-self: flex-start; transform-origin: center; text-overflow: clip; -unity-font-style: normal; white-space: normal; padding-right: 0; margin-top: 0; letter-spacing: 3px; word-spacing: 3px; padding-bottom: 0; flex-grow: 1;">
                    <Label text="As new students at Aalborg University, we have faced&#10;problems and believe medialogy students could fix&#10;some of them. The scope of problems was narrowed&#10;down with surveys and observations of our own as&#10;well as from our classmates. These problems include&#10;confusion with finding required books at a reasonable price, navigating the campus due to the confusing nature of CREATE’s numeration system for the&#10;areas and rooms, and a digital student ID in case&#10;a student forgets the physical ID. Methods used to&#10;develop the solution included brainstorming, wireframes of the app’s interface as well as conceptual&#10;and mental models." style="-unity-text-align: middle-left; font-size: 45px; white-space: normal; margin-bottom: 47px; padding-left: 1px; margin-left: -230px;" />
                </Foldout>
            </VisualElement>
            <VisualElement class="ui_element_background" style="flex-grow: 1; flex-direction: row; width: 95%; align-self: center; height: auto; margin-top: 15px; margin-bottom: 15px;">
                <VisualElement enabled="false" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; width: 300px; height: 200px; align-self: stretch; margin-top: 10px; margin-bottom: 0; padding-top: 0; border-top-width: 0; border-bottom-width: 0; top: 19px; left: auto; align-items: stretch; justify-content: space-between;" />
                <Foldout text="UI Subversion and Reflection Found in Phone Games" value="false" enabled="true" name="Foldout" style="-unity-text-align: middle-center; width: 100%; height: auto; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=13ff8cb063d69b84bba985c7c7ef9c52&amp;type=3#Barlow-Regular&quot;); min-height: auto; max-height: none; align-items: stretch; justify-content: space-evenly; align-self: flex-start; transform-origin: center; text-overflow: clip; -unity-font-style: normal; white-space: normal; padding-right: 0; margin-top: 0; letter-spacing: 3px; word-spacing: 3px; padding-bottom: 0; flex-grow: 1;">
                    <Label text="This Doesn’t Have to Be the End&#10;of Everything: UI Subversion and Reflection in Found&#10;Phone Games, a project exploring the intersection of&#10;user interface design, player perception, and digital literacy through the development of a &quot;found phone&quot; game.The game leverages UI-subversion and real-time data&#10;tracking to provoke reflection on digital manipulation,&#10;persuasive design, and data privacy. Through the&#10;integration of Norman’s design principles, intentional&#10;friction strategies, and narrative gameplay techniques,&#10;the project investigates how interactive storytelling&#10;can raise awareness about dark patterns, nudging, and&#10;algorithmic influence. User testing showed that the game&#10;was generally well-received, with high usability scores&#10;and strong engagement levels. While quantitative data&#10;did not show statistically significant differences between&#10;test groups, qualitative feedback highlighted that players&#10;found the narrative thought-provoking and the UI design&#10;cleverly deceptive - often provoking reflection as intended." style="-unity-text-align: middle-left; font-size: 45px; white-space: normal; margin-bottom: 47px; padding-left: 1px; margin-left: -230px;" />
                </Foldout>
            </VisualElement>
            <VisualElement class="ui_element_background" style="flex-grow: 1; flex-direction: row; width: 95%; align-self: center; height: auto; margin-top: 15px; margin-bottom: 15px;">
                <VisualElement enabled="false" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; width: 300px; height: 200px; align-self: stretch; margin-top: 10px; margin-bottom: 0; padding-top: 0; border-top-width: 0; border-bottom-width: 0; top: 19px; left: auto; align-items: stretch; justify-content: space-between;" />
                <Foldout text="Vell of Fear" value="false" enabled="true" name="Foldout" style="-unity-text-align: middle-center; width: 100%; height: auto; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=13ff8cb063d69b84bba985c7c7ef9c52&amp;type=3#Barlow-Regular&quot;); min-height: auto; max-height: none; align-items: stretch; justify-content: space-evenly; align-self: flex-start; transform-origin: center; text-overflow: clip; -unity-font-style: normal; white-space: normal; padding-right: 0; margin-top: 0; letter-spacing: 3px; word-spacing: 3px; padding-bottom: 0; flex-grow: 1;">
                    <Label text="Eye-tracking used in gaming is a relatively new&#10;and unexplored subject. This project aims to&#10;investigate the extent to which eye-tracking can&#10;enhance immersion in the horror game &quot;Veil of&#10;Fear&quot;. The game includes 4 events using eyetracking input featured throughout the experience.&#10;This study involved 63 test participants and&#10;employed a questionnaire, based on an Immersive&#10;Experience Questionnaire (IEQ) and a User&#10;Engagement Scale (UES). The product was A/B&#10;tested on an experimental group with eye-tracking&#10;and a control group without eye-tracking. The&#10;results showed high immersion in both versions of&#10;the game but when comparing the immersion&#10;scores, no significant difference was found&#10;between the complete samples. Yet some&#10;subsamples showed a significant difference" style="-unity-text-align: middle-left; font-size: 45px; white-space: normal; margin-bottom: 47px; padding-left: 1px; margin-left: -230px;" />
                </Foldout>
            </VisualElement>
            <VisualElement class="ui_element_background" style="flex-grow: 1; flex-direction: row; width: 95%; align-self: center; height: auto; margin-top: 15px; margin-bottom: 15px;">
                <VisualElement enabled="false" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; width: 300px; height: 200px; align-self: stretch; margin-top: 10px; margin-bottom: 0; padding-top: 0; border-top-width: 0; border-bottom-width: 0; top: 19px; left: auto; align-items: stretch; justify-content: space-between;" />
                <Foldout text="VR with Nature-Based and&#10;Anthropogenic-Based&#10;Soundscapes&#10;" value="false" enabled="true" name="Foldout" style="-unity-text-align: middle-center; width: 100%; height: auto; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=13ff8cb063d69b84bba985c7c7ef9c52&amp;type=3#Barlow-Regular&quot;); min-height: auto; max-height: none; align-items: stretch; justify-content: space-evenly; align-self: flex-start; transform-origin: center; text-overflow: clip; -unity-font-style: normal; white-space: normal; padding-right: 0; margin-top: 0; letter-spacing: 3px; word-spacing: 3px; padding-bottom: 0; flex-grow: 1;">
                    <Label text="The purpose of this study was to analyse and test the potential difference in the effect on mood that various soundscapes might have.&#10;Specifically, the effect of a nature- and a anthropogenic-based soundscape are compared. The analysis covers topics such as mood, soundscapes, audio rendering, audio effects and virtual reality. After this&#10;preliminary research, it was discovered that nature-based environments might have a better change at improving a person’s mood compared to anthropogenic-based environments. Later on, it was hypothesized that nature- and anthropogenic-based soundscapes might produce the same results. Based on the analysis, an artifact was designed&#10;and implemented to test the effects of different soundscapes on mood.&#10;The artifact consists of a virtual reality experience with two different&#10;virtual environments, both of which have the same visuals and interactions, but with varying soundscapes. One featuring nature-based&#10;sounds, the other with a combination of nature and anthropogenic&#10;sounds. 30 participants were randomly separated into two equally&#10;large groups, were they were individually being exposed to either of&#10;the two environments. Pre- and post-questionnaires utilising the Positive and Negative Affect Scale were used for determining the negative&#10;and positive mood of the participants before and after going through&#10;the virtual reality experience. Through an analysis of the results, it&#10;was found that the environment containing the nature-based soundscape did not increase the positive mood of the participants any more&#10;than the anthropogenic-based. However, both environments had a&#10;decrease in the participants’ negative mood." style="-unity-text-align: middle-left; font-size: 45px; white-space: normal; margin-bottom: 47px; padding-left: 1px; margin-left: -230px;" />
                </Foldout>
            </VisualElement>
            <VisualElement class="ui_element_background" style="flex-grow: 1; flex-direction: row; width: 95%; align-self: center; height: auto; margin-top: 15px; margin-bottom: 15px;">
                <VisualElement enabled="false" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; width: 300px; height: 200px; align-self: stretch; margin-top: 10px; margin-bottom: 0; padding-top: 0; border-top-width: 0; border-bottom-width: 0; top: 19px; left: auto; align-items: stretch; justify-content: space-between;" />
                <Foldout text="Switchgear Operator Training" value="false" enabled="true" name="Foldout" style="-unity-text-align: middle-center; width: 100%; height: auto; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=13ff8cb063d69b84bba985c7c7ef9c52&amp;type=3#Barlow-Regular&quot;); min-height: auto; max-height: none; align-items: stretch; justify-content: space-evenly; align-self: flex-start; transform-origin: center; text-overflow: clip; -unity-font-style: normal; white-space: normal; padding-right: 0; margin-top: 0; letter-spacing: 3px; word-spacing: 3px; padding-bottom: 0; flex-grow: 1;">
                    <Label text="When working inside wind turbines it can be&#10;very dangerous and even the minor mistakes&#10;can have deadly consequences. Virtual reality&#10;training has become more and more prevalent in teaching. Using virtual reality training program can help uphold the expertise&#10;of the operators, but how do these environments look? The purpose of this report is to&#10;compare the preferability of different visual&#10;styles of environments when doing simulated&#10;training. In collaboration with energy company Vattenfall we created four versions of&#10;a switchgear operator simulation. Each of&#10;the four versions had different environment&#10;styles, those being a stylised version, an HD&#10;version, a laser scanned version, and an AR&#10;version. The stylised and HD were reconstructions of an offshore wind turbine platform, the scanned version was a scan of the&#10;training room where training normally would&#10;happen, and the AR version was an image&#10;tracker using a 3D model of the switchgear.&#10;The interactions in the simulation was based&#10;on personally trying a switchgear. &#10;" style="-unity-text-align: middle-left; font-size: 45px; white-space: normal; margin-bottom: 47px; padding-left: 1px; margin-left: -230px;" />
                </Foldout>
            </VisualElement>
            <VisualElement class="ui_element_background" style="flex-grow: 1; flex-direction: row; width: 95%; align-self: center; height: auto; margin-top: 15px; margin-bottom: 15px;">
                <VisualElement enabled="false" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Images/logo/chevron_left_thin.png?fileID=2800000&amp;guid=9839b7d93b80f2244a558244d7ff04dc&amp;type=3#chevron_left_thin&quot;); -unity-background-scale-mode: scale-to-fit; width: 300px; height: 200px; align-self: stretch; margin-top: 10px; margin-bottom: 0; padding-top: 0; border-top-width: 0; border-bottom-width: 0; top: 19px; left: auto; align-items: stretch; justify-content: space-between;" />
                <Foldout text="Indigenous Star Lore" value="false" enabled="true" name="Foldout" style="-unity-text-align: middle-center; width: 100%; height: auto; font-size: 65px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Barlow/Barlow-Regular.ttf?fileID=12800000&amp;guid=13ff8cb063d69b84bba985c7c7ef9c52&amp;type=3#Barlow-Regular&quot;); min-height: auto; max-height: none; align-items: stretch; justify-content: space-evenly; align-self: flex-start; transform-origin: center; text-overflow: clip; -unity-font-style: normal; white-space: normal; padding-right: 0; margin-top: 0; letter-spacing: 3px; word-spacing: 3px; padding-bottom: 0; flex-grow: 1;">
                    <Label text="Dette projekt har udforsket, hvordan Virtual&#10;Reality (VR) kan anvendes til at bevare og&#10;formidle stjerne fortællinger fra Ju/’Hoansi&#10;San-samfundet i Namibia. Ved at udvikle&#10;en VR-oplevelse baseret pa myten ”Strudsen ˚&#10;pa himlen” har vi kombineret lydoptagelser ˚&#10;pa Ju/’hoan-sproget med engelsk oversættelse, ˚&#10;hand-tracking-interaktioner og low-poly mod- ˚&#10;eller inspireret af lokale tegninger leveret af&#10;samfundet. Prototypen er designet til Oculus Quest 3 og er blevet testet i Danmark og&#10;evalueret i forhold til, VR-sygdomssymptomer&#10;spørgeskema og semi-strukturerede interviews.&#10;Testpersoner rapporterede høj tilstedeværelse&#10;under interaktive momenter af historien samt&#10;minimal ubehagsfølelse, mens omrader som ˚&#10;oplevelsens evne til at holde testpersonernes&#10;fokus skulle forbedres. Projektet demonstrerer&#10;vigtigheden af inklusion af interessanter i udviklings design og lægger fundamentet for fremtidige, kulturelle VR-oplevelser." style="-unity-text-align: middle-left; font-size: 45px; white-space: normal; margin-bottom: 47px; padding-left: 1px; margin-left: -230px;" />
                </Foldout>
            </VisualElement>
        </ScrollView>
    </VisualElement>
    <Instance template="buttom_bar" />
</UXML>
